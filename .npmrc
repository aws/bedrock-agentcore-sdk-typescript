; @strands-agents/sdk declares an optional peer on @opentelemetry/* 2.x, while this package pins
; OpenTelemetry at 1.30.x. The mismatch is on an *optional* peer, so it does not affect runtime, but
; npm's strict peer resolution rejects it on a clean install. legacy-peer-deps relaxes that check for
; every install path (local, `npm ci`, and CI's `npm install`) without needing a manual flag.
legacy-peer-deps=true
